 from canatune.config import load_config
 from canatune.controller.tier_controller import ControllerConfigError, ControllerSettings
 from canatune.domain.groups import Tier
+from canatune.infrastructure.clocks import GpuRef
+
+
+def all_refs() -> dict[str, GpuRef]:
+    names = [f"{role}{i}" for i in range(4) for role in "PD"]
+    return {name: GpuRef("http://agent", i) for i, name in enumerate(names)}
 
 
 def published_groups(production_clocks: str):
     _, _, groups, _, router, controller, actuator = setup()
+    controller.gpu_refs = all_refs()
     controller.settings = dataclasses.replace(
         controller.settings, production_clocks=production_clocks
     )
@@ -33,8 +40,48 @@ def test_canary_default_moves_production_to_h() -> None:
     assert all(g.tier is Tier.H and g.effective == H for g in production)
 
 
+def test_driver_releases_locks_while_admission_uses_the_table() -> None:
+    production, router, actuator = published_groups("driver")
+    assert all(g.tier is Tier.H and g.effective == MAX for g in production)
+    assert not router.open_admission  # the Canary's table still drives admission
+    assert actuator.calls == []  # no production group was ever locked
+    assert len(set(actuator.resets)) == 2 * len(production)
+
+
+def test_driver_mode_parks_and_recovers_without_locking() -> None:
+    _, _, groups, _, _, controller, actuator = setup()
+    controller.gpu_refs = all_refs()
+    controller.settings = dataclasses.replace(controller.settings, production_clocks="driver")
+    asyncio.run(controller.start())
+    asyncio.run(controller.publish(published(), "test"))
+    group = groups[1]
+    before = len(actuator.resets)
+    asyncio.run(controller.set_tier(group, Tier.PARK, "drained"))
+    assert group.effective is None
+    asyncio.run(controller.set_tier(group, Tier.MAX, "boost"))
+    asyncio.run(controller.set_tier(group, Tier.H, "unboost"))
+    assert group.effective == MAX
+    assert len(actuator.resets) == before + 6
+    assert actuator.calls == []
+
+
+def test_driver_reset_failure_is_not_ready() -> None:
+    _, _, groups, _, _, controller, actuator = setup()
+    controller.settings = dataclasses.replace(controller.settings, production_clocks="driver")
+
+    async def fail(ref):
+        raise RuntimeError("nvidia-smi failed")
+
+    controller.gpu_refs = all_refs()
+    actuator.reset = fail
+    asyncio.run(controller.start())
+    assert controller.state()["driver_clocks_ready"] is False
+    assert not controller._driver_ready
+    assert all(g.effective is None for g in groups[1:])  # not routable until released
+
+
