    "axis_search_levels": {"prefill": 17, "decode": 15},
    "frequency_grids": {
      "prefill": {"minimum_mhz": 900, "maximum_mhz": 2520, "levels": 17},
      "decode": {"minimum_mhz": 450, "maximum_mhz": 1500, "levels": 15}
    },
    "search_order": ["prefill", "decode"],
    "algorithm": "one_copy_per_class_binary_plus_greedy_coordinate_search_P_then_D_under_separable_energy_assumption",
    "energy_refinement_candidate_budget": 9,
    "exploration_max_attempts": 3,
    "exploration_retry_backoff_s": 5.0,
    "exploration_shutdown_timeout_s": 36000.0
  },
  "steady_state": {
    "discard_first_per_configuration_window": 3,
    "minimum_samples": 8,
    "maximum_cv": 0.10
  },
  "scrape_interval_s": 1.0,
  "collector": {"timeout_s": 5.0},
  "pre_window_s": 1.0,
  "post_window_s": 0.5,
  "sampling": {
    "period_s": 0.2,
    "late_tolerance_s": 0.05,
    "readiness_timeout_s": 180.0,
    "maximum_gap_s": 0.5,
    "maximum_boundary_gap_s": 0.4,
    "minimum_coverage_ratio": 0.9
  },
  "client": {
