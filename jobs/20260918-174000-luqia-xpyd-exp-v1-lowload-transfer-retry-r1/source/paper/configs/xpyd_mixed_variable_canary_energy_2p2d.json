{
  "model": "$XPYD_LOCAL_MODEL_PATH",
  "tokenizer_model": "$XPYD_LOCAL_MODEL_PATH",
  "vllm_version": "0.15.1",
  "output_root": "$XPYD_FEEDBACK_TABLE_OUTPUT_ROOT",
  "proxy_uri": "$XPYD_PROXY_URI",
  "proxy_diagnostics_log": "$XPYD_PROXY_DIAGNOSTICS_LOG",
  "frequency_table_path": "$XPYD_FREQUENCY_TABLE_PATH",
  "routing_policy": "round_robin",
  "workload_ordering": "seven_contiguous_workload_transfer_windows",
  "background_experiment_traffic": true,
  "cold_start_unknown_system": true,
  "historical_seed_enabled": false,
  "search_prior": "none",
  "mixed_variable_energy_validation": {
    "driver": "xpyd.mixed_variable_canary_energy",
    "mode": "sequential_low_load_canary_to_production_transfer",
    "random_seed": 20260912,
    "baseline_requests_per_workload": 12,
    "transfer_requests_per_workload": 48,
    "request_interval_s": 5.0,
    "canary_queue_wait_s": 21600.0,
    "terminal_slo_failure_policy": "publish_explicit_safe_high_fallback",
    "production_clock_policy": "record_only_never_abort_for_mismatch",
    "canary_clock_exhaustion_policy": "publish_explicit_safe_high_fallback",
    "terminal_infrastructure_failure_policy": "record_and_continue",
    "frequency_settle_s": 0.15,
    "request_timeout_s": 900.0,
    "exploration_timeout_s": 43200.0,
    "primary_energy_boundary": "client_send_to_completed_stream",
    "secondary_energy_boundary": "before_frequency_actuation_to_completed_stream",
    "slo_policy": "Canary copies one Production request per class, performs one P-axis binary-plus-greedy energy search followed by one D-axis binary-plus-greedy energy search, confirms the joint P/D point, and then publishes exactly one Table entry; exhausted search publishes fallback; Production violations are recorded only",
    "design_note": "Low-load transfer experiment: P0D0 Canary copies one request from each class, finds P and D coordinate-wise energy minima under the separable P-energy-plus-D-energy global-optimum assumption, confirms that joint point, writes the Table once, and stops experimenting for that class. The isolated P1D1 Production group first runs a same-class high-frequency baseline and then runs 48 requests at the learned P/D pair. The seven classes are strictly sequential. Missing Canary Table data and individual request failures are recorded rather than terminating the remaining windows."
  },
  "tiered_flow": {
    "purpose": "three_tier_observational_flow_validation_with_controlled_pd_cross_routes_not_global_optimality",
    "frequency_policy": "all_production_endpoints_start_high_then_selected_endpoint_tiers_apply_per_drained_burst",
    "tiers": {
      "high": {"pair": ["P1", "D1"], "prefill_mhz": 2520, "decode_mhz": 1500},
      "middle": {"pair": ["P2", "D2"], "prefill_mhz": 1710, "decode_mhz": 975},
      "low": {"pair": ["P3", "D3"], "prefill_mhz": 900, "decode_mhz": 450}
    },
    "endpoint_frequency_mhz": {
      "P1": 2520, "P2": 1710, "P3": 900,
      "D1": 1500, "D2": 975, "D3": 450
    },
    "route_control_path": "$XPYD_ROUTE_CONTROL_PATH",
    "route_control_reload": "before_each_drained_production_burst",
    "production_assignment": "round_robin_logical_tier_per_drained_homogeneous_burst"
  },
  "telemetry_contract": {
    "schema_version": 1,
    "output": "nodegroup_telemetry.jsonl",
    "arrival_rate_window_s": 60.0,
    "prefill_capacity_input_tokens_per_s": null,
    "decode_capacity_output_tokens_per_s": null,
    "rho_policy": "null_until_capacity_is_calibrated; never infer capacity from the same observation",
    "batch_size_policy": "max_of_current_prefill_and_decode_running_requests",
    "metrics_policy": "read_only_vllm_prometheus_scrape; unavailable metrics are null with telemetry_errors"
  },
  "online_feedback": {
    "enabled": true,
    "service_pair": ["P1", "D1"],
    "experiment_pair": ["P0", "D0"],
    "service_request_interval_s": 5.0,
    "probe_request_interval_s": 5.0,
