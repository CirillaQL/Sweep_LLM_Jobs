{
  "model": "mistralai/Mistral-7B-v0.1",
  "tokenizer_model": "mistralai/Mistral-7B-v0.1",
  "vllm_version": "0.15.1",
  "output_root": "results/xpyd_observability",
  "scrape_interval_s": 1.0,
  "scrape_late_tolerance_s": 0.1,
  "staleness_threshold_s": 2.5,
  "request_timeout_s": 900.0,
  "collector": {"timeout_s": 5.0},
  "load_monitoring": {
    "minimum_interval_scrapes_per_endpoint": 1,
    "maximum_consecutive_failures_per_endpoint": 3
  },
  "client": {
    "base_url": "$XPYD_PROXY_URI",
    "script": "paper/scripts/replay_synthetic_trace.py",
    "protocol": "OpenAI-compatible real SSE /v1/completions through disagg_proxy.py",
    "require_server_token_usage": true,
    "require_real_decode_streaming": true,
    "require_logical_request_id_propagation": true
  },
  "phase_warmup": {
    "enabled": true,
    "input_len": 128,
    "output_len": 128,
    "count": 1,
    "max_concurrency": 1
  },
  "endpoints": [
    {
      "endpoint_id": "P0", "role": "prefill", "gpu_type": "NVIDIA L40S",
      "node": "uranus", "gpu_ids": [0], "tp_degree": 1,
      "http_uri": "$XPYD_P_HTTP_URI", "kv_connector": "P2pNcclConnector"
    },
    {
      "endpoint_id": "D0", "role": "decode", "gpu_type": "NVIDIA L4",
      "node": "europa", "gpu_ids": [0], "tp_degree": 1,
      "http_uri": "$XPYD_D_HTTP_URI", "kv_connector": "P2pNcclConnector"
    }
  ],
  "semantic_probes": [
    {"id": "semantic_il128_ol128", "input_len": 128, "output_len": 128, "count": 1, "max_concurrency": 1}
  ],
  "load_probes": [
    {"id": "load_light_il128_ol128", "input_len": 128, "output_len": 128, "rate_rps": 0.5, "duration_s": 10, "count": 5, "max_concurrency": 2}
  ],
  "server_logs": {"P0": "$XPYD_P_SERVER_LOG", "D0": "$XPYD_D_SERVER_LOG"},
  "proxy_diagnostics_log": "$XPYD_PROXY_DIAGNOSTICS_LOG",
  "physical_context": {
    "scheduler": "Slurm",
    "slurm_job_id": "$SLURM_JOB_ID",
    "allocation": "exclusive uranus + europa",
    "prefill_kv_role": "kv_producer",
    "decode_kv_role": "kv_consumer",
    "frequency_policy": "untouched",
    "energy_collection": "Phase 3B isolated read-only node-local NVML"
  }
}
