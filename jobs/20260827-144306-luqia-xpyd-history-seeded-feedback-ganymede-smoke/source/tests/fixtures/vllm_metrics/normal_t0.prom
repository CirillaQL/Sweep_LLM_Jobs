# TYPE vllm:num_requests_running gauge
vllm:num_requests_running{model_name="model-a"} 1
# TYPE vllm:num_requests_waiting gauge
vllm:num_requests_waiting{model_name="model-a"} 0
# TYPE vllm:kv_cache_usage_perc gauge
vllm:kv_cache_usage_perc{model_name="model-a"} 0.25
# TYPE vllm:prompt_tokens_total counter
vllm:prompt_tokens_total{model_name="model-a"} 1000
# TYPE vllm:generation_tokens_total counter
vllm:generation_tokens_total{model_name="model-a"} 500
# TYPE vllm:request_success_total counter
vllm:request_success_total{model_name="model-a",finished_reason="stop"} 18
vllm:request_success_total{model_name="model-a",finished_reason="length"} 2
vllm:request_success_total{model_name="model-a",finished_reason="abort"} 1
# TYPE vllm:time_to_first_token_seconds histogram
vllm:time_to_first_token_seconds_bucket{model_name="model-a",le="0.05"} 10
vllm:time_to_first_token_seconds_bucket{model_name="model-a",le="0.1"} 20
vllm:time_to_first_token_seconds_bucket{model_name="model-a",le="0.2"} 20
vllm:time_to_first_token_seconds_bucket{model_name="model-a",le="0.5"} 20
vllm:time_to_first_token_seconds_bucket{model_name="model-a",le="+Inf"} 20
vllm:time_to_first_token_seconds_count{model_name="model-a"} 20
vllm:time_to_first_token_seconds_sum{model_name="model-a"} 1.2
# TYPE vllm:inter_token_latency_seconds histogram
vllm:inter_token_latency_seconds_bucket{model_name="model-a",le="0.02"} 10
vllm:inter_token_latency_seconds_bucket{model_name="model-a",le="0.05"} 40
vllm:inter_token_latency_seconds_bucket{model_name="model-a",le="0.1"} 50
vllm:inter_token_latency_seconds_bucket{model_name="model-a",le="0.2"} 50
vllm:inter_token_latency_seconds_bucket{model_name="model-a",le="+Inf"} 50
vllm:inter_token_latency_seconds_count{model_name="model-a"} 50
vllm:inter_token_latency_seconds_sum{model_name="model-a"} 2.0
# TYPE vllm:request_queue_time_seconds histogram
vllm:request_queue_time_seconds_bucket{model_name="model-a",le="0.01"} 20
vllm:request_queue_time_seconds_bucket{model_name="model-a",le="+Inf"} 20
vllm:request_queue_time_seconds_count{model_name="model-a"} 20
vllm:request_queue_time_seconds_sum{model_name="model-a"} 0.1
