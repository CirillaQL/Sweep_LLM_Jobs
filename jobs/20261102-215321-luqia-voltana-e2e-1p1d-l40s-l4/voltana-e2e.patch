diff --color -ruN base/python/sglang/srt/managers/freq_setter_nvsmi.py new/python/sglang/srt/managers/freq_setter_nvsmi.py
--- base/python/sglang/srt/managers/freq_setter_nvsmi.py	1970-01-01 01:00:00
+++ new/python/sglang/srt/managers/freq_setter_nvsmi.py	2026-11-02 21:54:04
@@ -0,0 +1,76 @@
+"""Unprivileged variant of freq_setter.py: same ZMQ protocol, clocks set with `sudo -n nvidia-smi`.
+
+freq_setter.py needs a root python (pynvml.nvmlDeviceSetGpuLockedClocks); on clusters that only
+allow `sudo -n nvidia-smi`, FreqManager starts this one instead (VOLTANA_FREQ_SETTER=nvidia-smi).
+An nvidia-smi call takes tens to hundreds of ms, so targets that arrive meanwhile are coalesced
+and only the latest one is applied. Every change is logged with its duration.
+"""
+
+import argparse
+import subprocess
+import sys
+import time
+from typing import List, Optional
+
+import zmq
+
+
+def run_nvsmi(gpu_idx: List[int], args: List[str]) -> bool:
+    ok = True
+    for idx in gpu_idx:
+        proc = subprocess.run(
+            ["sudo", "-n", "nvidia-smi", "-i", str(idx)] + args,
+            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
+        )
+        # judged by the output: nvidia-smi has exited non-zero after a successful lock
+        if "All done" not in proc.stdout:
+            ok = False
+            print(f"[freq_setter_nvsmi] gpu {idx} {' '.join(args)} failed rc={proc.returncode}: {proc.stdout.strip()}", flush=True)
+    return ok
+
+
+def event_loop(gpu_idx: List[int], zmq_input: str, zmq_output: str):
+    context = zmq.Context()
+    socket_input = context.socket(zmq.PULL)
+    socket_input.bind(zmq_input)
+    socket_output = context.socket(zmq.PUSH)
+    socket_output.connect(zmq_output)
+
+    f_last: Optional[int] = None
+    print(f"[freq_setter_nvsmi] gpus {gpu_idx} listening on {zmq_input}", flush=True)
+    while True:
+        objs = [socket_input.recv_pyobj()]
+        while True:  # coalesce whatever queued up during the last nvidia-smi call
+            try:
+                objs.append(socket_input.recv_pyobj(flags=zmq.NOBLOCK))
+            except zmq.Again:
+                break
+        targets = [obj for obj in objs if isinstance(obj, int)]
+        if not targets:
+            continue
+        f_target = targets[-1]
+        if f_target == f_last:
+            continue
+
+        t0 = time.time()
+        if f_target == 0:
+            ok = run_nvsmi(gpu_idx, ["-rgc"])
+            f_last = None
+            socket_output.send_pyobj(ok, flags=zmq.NOBLOCK, copy=True)
+        else:
+            ok = run_nvsmi(gpu_idx, ["-lgc", f"{f_target},{f_target}"])
+            f_last = f_target if ok else None
+        print(f"[freq_setter_nvsmi] t={t0:.3f} set={f_target} ok={ok} took_ms={(time.time() - t0) * 1000:.0f} "
+              f"coalesced={len(targets) - 1}", flush=True)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description="Frequency setter (sudo -n nvidia-smi)")
+    parser.add_argument("--gpu-index", type=int, nargs="+", required=True)
+    parser.add_argument("--zmq-input", type=str, required=True)
+    parser.add_argument("--zmq-output", type=str, required=True)
+    args = parser.parse_args()
+    try:
+        event_loop(args.gpu_index, args.zmq_input, args.zmq_output)
+    except KeyboardInterrupt:
+        sys.exit(0)
