new file mode 100644
index 00000000..46597925
--- /dev/null
+++ b/voltana-llm-scripts/predictions/fit_latency.py
@@ -0,0 +1,205 @@
+"""Fit the EcoPred latency tables without Jupyter (same regression as prefill/ and decode/ draw.ipynb).
+
+Usage:
+    python fit_latency.py --phase prefill --data-dir <dir with <freq>/ subdirs> --out-dir <dir>
+    python fit_latency.py --phase decode  --data-dir <dir with <freq>/ subdirs> --out-dir <dir>
+
+Writes latency-<phase>.csv (the lookup table format read by sglang.srt.managers.lookup_table),
+points-<phase>.csv.gz (the samples the fit used) and latency-<phase>.png.
+"""
+
+import argparse
+import glob
+import os
+
+import matplotlib
+
+matplotlib.use("Agg")
+
+import matplotlib.pyplot as plt
+import numpy as np
+import orjson
+import pandas as pd
+from sklearn.linear_model import LinearRegression, RANSACRegressor
+from sklearn.metrics import r2_score
+
+# decode batch-size segments (CUDA graph buckets), as in decode/draw.ipynb
+STEPS_END = [4, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112, 120, 128,
+             256, 384, 512, 640, 768, 896, 1024, 1152, 1280, 1408, 1536, 1664, 1792, 1920, 2048]
+STEPS_BEG = [1] + [v + 1 for v in STEPS_END[:-1]]
+
+
+def freq_dirs(data_dir: str):
+    for name in sorted(os.listdir(data_dir)):
+        path = os.path.join(data_dir, name)
+        if name.isdigit() and os.path.isdir(path):
+            yield int(name), path
+
+
+def load_prefill(data_dir: str) -> pd.DataFrame:
+    rows = []
+    for freq, path in freq_dirs(data_dir):
+        for file in sorted(glob.glob(os.path.join(path, "*-extra.json"))):
+            print(f"loading {file}")
+            with open(file, "rb") as f:
+                reqs = orjson.loads(f.read())
+            for items in reqs.values():
+                for item in items or []:
+                    if item["forward_mode"] != 1:
+                        continue
+                    rows.append((
+                        freq,
+                        item["iteration_counter"],
+                        sum(item["num_total_computing_tokens_list"]),
+                        (item["timestamp_before_output"] - item["timestamp_begin"]) * 1000,
+                    ))
+    df = pd.DataFrame(rows, columns=["freq", "iteration_counter", "tokens", "ttft_exec"])
+    # every request of a batch reports the same iteration; keep one row per iteration
+    df = df.drop_duplicates(subset=["freq", "iteration_counter"], keep="last")
+    return df.sort_values(by=["freq", "tokens", "ttft_exec"], ignore_index=True)
+
+
+def fit_prefill(df: pd.DataFrame, tokens_min: float, tokens_max: float, png: str) -> pd.DataFrame:
+    fig, ax = plt.subplots(figsize=(12, 5))
+    table = []
+    for freq in sorted(df["freq"].unique()):
+        df_freq = df[df["freq"] == freq]
+        xs = df_freq["tokens"].to_numpy()
+        ys = df_freq["ttft_exec"].to_numpy()
+        sel = (xs > tokens_min) & (xs < tokens_max)
+        if sel.sum() < 2:
+            print(f"freq {freq}: only {sel.sum()} points in ({tokens_min}, {tokens_max}) tokens, skipped")
+            continue
+        model = RANSACRegressor(LinearRegression(positive=True), max_trials=100000, random_state=1)
+        model.fit(xs[sel].reshape(-1, 1), ys[sel])
+        y_pred = model.predict(xs.reshape(-1, 1))
+        r2 = r2_score(ys, y_pred)
+        ax.scatter(xs, ys, alpha=0.5)
+        ax.plot(xs, y_pred, label=f"f = {freq} MHz (r² = {r2:.5f})", linewidth=2)
+        table.append({
+            "freq": freq,
+            "coef_tokens": model.estimator_.coef_[0],
+            "coef_intercept": model.estimator_.intercept_,
+            "r_2": r2,
+            "n_points": int(sel.sum()),
+        })
+        print(table[-1])
+    ax.grid(True)
+    ax.legend(fontsize=11, loc="upper left")
+    ax.set_xlim(0)
+    ax.set_ylim(0)
+    ax.set_xlabel("#Batched Tokens")
+    ax.set_ylabel("TTFT (ms)")
+    fig.tight_layout()
+    fig.savefig(png, dpi=150)
+    return pd.DataFrame(table, columns=["freq", "coef_tokens", "coef_intercept", "r_2", "n_points"]).sort_values(by="freq", ignore_index=True)
+
+
+def load_decode(data_dir: str, itl_min: float, itl_max: float) -> pd.DataFrame:
+    frames = []
+    for freq, path in freq_dirs(data_dir):
+        for file in sorted(glob.glob(os.path.join(path, "*-extra.json"))):
+            print(f"loading {file}")
+            with open(file, "rb") as f:
+                reqs = orjson.loads(f.read())
+            rows = []
+            for infos in reqs.values():
+                for info in infos or []:
+                    if info["forward_mode"] != 2:
+                        continue
+                    rows.append((
+                        info["batch_size"],
+                        sum(info["num_total_computed_tokens_list"]),
+                        (info.get("itl", 0) or 0) * 1000,
+                    ))
+            del reqs
+            arr = np.asarray(rows, dtype=np.float64).reshape(-1, 3)
+            arr = arr[(arr[:, 2] > itl_min) & (arr[:, 2] < itl_max)]
+            frame = pd.DataFrame(arr, columns=["batch_size", "tokens", "itl"])
+            frame.insert(0, "freq", freq)
+            frames.append(frame)
+    df = pd.concat(frames, ignore_index=True) if frames else pd.DataFrame(columns=["freq", "batch_size", "tokens", "itl"])
+    return df.sort_values(by=["freq", "batch_size", "tokens", "itl"], ignore_index=True)
+
+
+def fit_decode(df: pd.DataFrame, png: str, min_points: int) -> pd.DataFrame:
+    fig = plt.figure(figsize=(6, 6))
+    ax = fig.add_subplot(111, projection="3d")
+    rng = np.random.default_rng(0)
+    table = []
+    for i, freq in enumerate(sorted(df["freq"].unique())):
+        df_freq = df[df["freq"] == freq]
+        xs_freq = df_freq["batch_size"].to_numpy()
+        ys_freq = df_freq["tokens"].to_numpy()
+        zs_freq = df_freq["itl"].to_numpy()
+        label = f"f = {freq} MHz"
+        for beg, end in zip(STEPS_BEG, STEPS_END):
+            sel = (xs_freq >= beg) & (xs_freq <= end)
+            if sel.sum() < min_points:
+                # a few warm-up/tail iterations land in buckets the run did not target
+                if sel.sum():
+                    print(f"freq {freq} bs {beg}-{end}: only {sel.sum()} points (< {min_points}), skipped")
+                continue
+            xy = np.vstack((xs_freq[sel], ys_freq[sel])).T
+            zs = zs_freq[sel]
+            model = RANSACRegressor(LinearRegression(positive=True), max_trials=10000,
+                                    loss="squared_error", random_state=1)
+            try:
+                model.fit(xy, zs)
+            except ValueError as error:  # no RANSAC consensus set
+                print(f"freq {freq} bs {beg}-{end}: {sel.sum()} points, RANSAC failed ({error}), skipped")
+                continue
+            r2 = r2_score(zs, model.predict(xy))
+            table.append({
+                "freq": freq,
+                "bs_start": beg,
+                "bs_end": end,
+                "coef_bs": model.estimator_.coef_[0],
+                "coef_tokens": model.estimator_.coef_[1],
+                "coef_intercept": model.estimator_.intercept_,
+                "r_2": r2,
+                "n_points": int(sel.sum()),
+            })
+            print(table[-1])
+            draw = rng.choice(len(zs), min(100, len(zs)), replace=False)
+            ax.scatter(xy[draw, 0], xy[draw, 1], zs[draw], c=f"C{i}", s=10, alpha=0.5, label=label)
+            label = None
+    ax.set_xlabel("#Reqs")
+    ax.set_ylabel("#Computed Tokens", labelpad=10)
+    ax.set_zlabel("ITL (ms)")
+    ax.view_init(elev=35, azim=-135)
+    fig.legend(fontsize=9, loc="upper left")
+    fig.tight_layout()
+    fig.savefig(png, dpi=150)
+    columns = ["freq", "bs_start", "bs_end", "coef_bs", "coef_tokens", "coef_intercept", "r_2", "n_points"]
+    return pd.DataFrame(table, columns=columns).sort_values(by=["freq", "bs_start", "bs_end"], ignore_index=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--phase", choices=["prefill", "decode"], required=True)
+    parser.add_argument("--data-dir", required=True)
+    parser.add_argument("--out-dir", required=True)
+    parser.add_argument("--tokens-min", type=float, default=2000, help="prefill fit range (batched tokens)")
+    parser.add_argument("--tokens-max", type=float, default=20000)
+    parser.add_argument("--itl-min", type=float, default=3, help="decode ITL filter (ms)")
+    parser.add_argument("--itl-max", type=float, default=300)
+    parser.add_argument("--min-points", type=int, default=20, help="decode: skip batch-size buckets with fewer points")
+    args = parser.parse_args()
+
+    os.makedirs(args.out_dir, exist_ok=True)
+    png = os.path.join(args.out_dir, f"latency-{args.phase}.png")
+    if args.phase == "prefill":
+        df = load_prefill(args.data_dir)
+        table = fit_prefill(df, args.tokens_min, args.tokens_max, png)
+    else:
+        df = load_decode(args.data_dir, args.itl_min, args.itl_max)
+        table = fit_decode(df, png, args.min_points)
+    df.to_csv(os.path.join(args.out_dir, f"points-{args.phase}.csv.gz"), index=False)
+    # n_points is informational; lookup_table.py ignores unknown columns
+    table.to_csv(os.path.join(args.out_dir, f"latency-{args.phase}.csv"), index=False)
+    print(f"{len(df)} points, {len(table)} table rows -> {args.out_dir}")
+
+
+if __name__ == "__main__":
+    main()
