diff --git a/voltana-llm-scripts/predictions/slurm/profile.sbatch b/voltana-llm-scripts/predictions/slurm/profile.sbatch
new file mode 100644
index 00000000..2b220efc
--- /dev/null
+++ b/voltana-llm-scripts/predictions/slurm/profile.sbatch
@@ -0,0 +1,154 @@
+#!/bin/bash
+#SBATCH --job-name=voltana-profile
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --gres=gpu:1
+#SBATCH --cpus-per-task=8
+#SBATCH --mem=64G
+#SBATCH --time=04:00:00
+#SBATCH --output=voltana-profile-%x-%j.out
+
+# Profile prefill/decode latency at locked GPU frequencies on one GPU (see ../README.md).
+#
+# Usage (submit from voltana-llm-scripts/predictions with the voltanallm env activated):
+#   sbatch [--partition=...] [--gres=gpu:<type>:1] slurm/profile.sbatch <prefill|decode> <L40S|L4>
+#   # one frequency per array task (recommended for decode):
+#   sbatch --array=0-4 ... slurm/profile.sbatch decode L4
+#
+# Env overrides: MODEL_PATH, FREQ_LIST (e.g. 2520,2310,2100), N_FREQ, FREQ_MIN_RATIO,
+#   MEM_FRACTION, CONTEXT_LEN, MAX_RUNNING, CUDA_GRAPH_MAX_BS, MAX_TOKENS, OUT_DIR, PORT
+
+set -euo pipefail
+
+PHASE=${1:?usage: profile.sbatch <prefill|decode> <L40S|L4>}
+GPU=${2:?usage: profile.sbatch <prefill|decode> <L40S|L4>}
+
+PRED_DIR=${PRED_DIR:-${SLURM_SUBMIT_DIR:-$(pwd)}}
+if [[ ! -f "${PRED_DIR}/${PHASE}/run_profile.py" ]]; then
+    echo "cannot find ${PRED_DIR}/${PHASE}/run_profile.py; submit from voltana-llm-scripts/predictions or set PRED_DIR" >&2
+    exit 1
+fi
+
+## per-GPU presets (Mistral-7B-v0.1, bf16, TP=1)
+case "${GPU}" in
+    L40S)
+        GPU_TAG=${GPU_TAG:-L40S-48G}
+        : "${CONTEXT_LEN:=16384}" "${MAX_RUNNING:=1024}" "${CUDA_GRAPH_MAX_BS:=1024}"
+        ;;
+    L4)
+        # 24 GB: ~14.5 GB weights leaves only ~5-6 GB KV cache, keep batches and graphs small
+        GPU_TAG=${GPU_TAG:-L4-24G}
+        : "${CONTEXT_LEN:=8192}" "${MAX_RUNNING:=512}" "${CUDA_GRAPH_MAX_BS:=512}"
+        ;;
+    *)
+        echo "unknown GPU type: ${GPU} (expected L40S or L4)" >&2
+        exit 1
+        ;;
+esac
+# prefill needs more activation headroom than decode
+if [[ "${PHASE}" == prefill ]]; then : "${MEM_FRACTION:=0.85}"; else : "${MEM_FRACTION:=0.88}"; fi
+export MEM_FRACTION CONTEXT_LEN MAX_RUNNING CUDA_GRAPH_MAX_BS GPU_TAG
+export MODEL_PATH=${MODEL_PATH:-mistralai/Mistral-7B-v0.1}
+export HOST=localhost
+export PORT=${PORT:-$((20000 + ${SLURM_JOB_ID:-0} % 10000))}
+
+python -c "import sglang" || { echo "sglang not importable; activate the voltanallm env before sbatch" >&2; exit 1; }
+
+## resolve the NVML index of the GPU Slurm gave us (CUDA index 0 inside the job)
+cuda_uuid=$(python -c "import torch; print(str(torch.cuda.get_device_properties(0).uuid))")
+cuda_uuid=${cuda_uuid#GPU-}
+NVML_GPU_IDX=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader \
+    | awk -F', ' -v u="GPU-${cuda_uuid}" '$2 == u { print $1 }')
+if [[ -z "${NVML_GPU_IDX}" ]]; then
+    echo "cannot map CUDA device 0 (uuid ${cuda_uuid}) to an NVML index" >&2
+    nvidia-smi -L >&2
+    exit 1
+fi
+export NVML_GPU_IDX
+gpu_name=$(nvidia-smi -i "${NVML_GPU_IDX}" --query-gpu=name --format=csv,noheader)
+echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-} -> NVML index ${NVML_GPU_IDX} (${gpu_name})"
+if [[ "${gpu_name}" != *"${GPU}"* ]]; then
+    echo "allocated GPU '${gpu_name}' does not match requested type ${GPU}; pass --gres=gpu:<type>:1 or --partition" >&2
+    exit 1
+fi
+
+## frequency list: explicit FREQ_LIST, else N_FREQ supported clocks spaced in [FREQ_MIN_RATIO * max, max]
+if [[ -z "${FREQ_LIST:-}" ]]; then
+    supported=$(nvidia-smi -i "${NVML_GPU_IDX}" --query-supported-clocks=graphics --format=csv,noheader,nounits | sort -un)
+    FREQ_LIST=$(python - "${N_FREQ:-5}" "${FREQ_MIN_RATIO:-0.7}" ${supported} <<'EOF'
+import sys
+n, ratio, clocks = int(sys.argv[1]), float(sys.argv[2]), sorted({int(c) for c in sys.argv[3:]})
+f_max = clocks[-1]
+f_min = ratio * f_max
+targets = [f_max - i * (f_max - f_min) / (n - 1) for i in range(n)] if n > 1 else [f_max]
+picked = []
+for t in targets:
+    f = min(clocks, key=lambda c: abs(c - t))
+    if f not in picked:
+        picked.append(f)
+print(",".join(map(str, picked)))
+EOF
+)
+fi
+if [[ -n "${SLURM_ARRAY_TASK_ID:-}" ]]; then
+    IFS=, read -ra freqs <<< "${FREQ_LIST}"
+    if (( SLURM_ARRAY_TASK_ID >= ${#freqs[@]} )); then
+        echo "array task ${SLURM_ARRAY_TASK_ID} has no frequency (FREQ_LIST=${FREQ_LIST})" >&2
+        exit 1
+    fi
+    FREQ_LIST=${freqs[${SLURM_ARRAY_TASK_ID}]}
+fi
+export FREQ_LIST
+echo "frequencies to profile: ${FREQ_LIST}"
+
+## passwordless sudo is required to lock clocks; fail fast instead of recording mislabeled data
+if ! sudo -n nvidia-smi -i "${NVML_GPU_IDX}" -rgc > /dev/null; then
+    echo "sudo -n nvidia-smi -rgc failed; frequency locking needs passwordless sudo on this node" >&2
+    exit 1
+fi
+
+model_name=${MODEL_PATH%/}
+model_name=${model_name##*/}
+OUT_DIR=${OUT_DIR:-${PRED_DIR}/${PHASE}/results/${GPU_TAG}/${model_name}}
+mkdir -p "${OUT_DIR}"
+cd "${OUT_DIR}"
+echo "writing results to ${OUT_DIR}"
+
+server_pid=""
+monitor_pid=""
+cleanup() {
+    [[ -n "${monitor_pid}" ]] && kill "${monitor_pid}" 2> /dev/null || true
+    [[ -n "${server_pid}" ]] && kill "${server_pid}" 2> /dev/null || true
+    # never leave the clock locked for the next job on this GPU
+    sudo -n nvidia-smi -i "${NVML_GPU_IDX}" -rgc > /dev/null || true
+}
+trap cleanup EXIT
+
+## start the server on CUDA index 0 of this job
+if [[ "${PHASE}" == prefill ]]; then
+    bash "${PRED_DIR}/prefill/p_server.sh" 0 > "server-${SLURM_JOB_ID:-local}.log" 2>&1 &
+else
+    bash "${PRED_DIR}/decode/d_server.sh" 0 > "server-${SLURM_JOB_ID:-local}.log" 2>&1 &
+fi
+server_pid=$!
+
+echo "waiting for server on port ${PORT} ..."
+for _ in $(seq 1 360); do
+    if curl -sf "http://localhost:${PORT}/health" > /dev/null; then
+        break
+    fi
+    if ! kill -0 "${server_pid}" 2> /dev/null; then
+        echo "server exited during startup, see ${OUT_DIR}/server-${SLURM_JOB_ID:-local}.log" >&2
+        exit 1
+    fi
+    sleep 5
+done
+curl -sf "http://localhost:${PORT}/health" > /dev/null || { echo "server not ready after 30 min" >&2; exit 1; }
+
+## record actual clocks/power so power-capped runs (esp. L4, 72 W) can be spotted afterwards
+nvidia-smi -i "${NVML_GPU_IDX}" \
+    --query-gpu=timestamp,clocks.sm,clocks.mem,power.draw,temperature.gpu,clocks_throttle_reasons.active \
+    --format=csv -lms 500 > "clocks-${SLURM_JOB_ID:-local}.csv" &
+monitor_pid=$!
+
+python "${PRED_DIR}/${PHASE}/run_profile.py"
