      "decode": {"minimum_mhz": 450, "maximum_mhz": 1500, "levels": 15}
    },
    "axis_search_levels": {"prefill": 17, "decode": 15},
    "minimum_dwell_s": 0.10,
    "experiment_frequency_settle_s": 0.15
  },
  "sampling": {"period_s": 0.2, "late_tolerance_s": 0.05, "readiness_timeout_s": 180.0, "maximum_gap_s": 0.5, "maximum_boundary_gap_s": 0.4, "minimum_coverage_ratio": 0.9},
  "client": {"script": "paper/scripts/replay_synthetic_trace.py", "max_concurrency": 1, "request_timeout_s": 900},
  "endpoints": [
