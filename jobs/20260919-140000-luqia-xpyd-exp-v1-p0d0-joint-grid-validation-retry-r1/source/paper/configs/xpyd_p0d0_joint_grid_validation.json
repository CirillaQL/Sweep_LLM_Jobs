    {"endpoint_id": "D0", "role": "decode", "node": "ganymede", "gpu_type": "NVIDIA L4", "gpu_ids": [0], "cuda_visible_device": "0", "tp_degree": 1, "http_uri": "http://$XPYD_D0_HTTP_HOST:8200", "http_host": "$XPYD_D0_HTTP_HOST", "http_port": 8200, "addr_host": "$XPYD_D_ADDR_HOST", "kv_port": 14579, "kv_connector": "P2pNcclConnector", "configured_frequency_mhz": 1500, "expected_gpu_name": "L4"}
  ],
  "fixed_clocks": {
    "P0": {"graphics_mhz": 2520, "memory_mhz": 9001, "minimum_workload_match_fraction": 0.95},
    "D0": {"graphics_mhz": 1500, "memory_mhz": 6251, "minimum_workload_match_fraction": 0.95}
  },
  "compatible_pairs": [
    {"prefill_endpoint_id": "P0", "decode_endpoint_id": "D0", "connector": "P2pNcclConnector", "prefill_tp": 1, "decode_tp": 1, "supported": true, "reason": "sole joint-grid experiment pair"}
  ],
  "workloads": [
    {"id": "small_light", "input_len": 160, "output_len": 64, "count": 1, "rate_rps": 0.2},
    {"id": "prefill_medium", "input_len": 1024, "output_len": 64, "count": 1, "rate_rps": 0.2},
