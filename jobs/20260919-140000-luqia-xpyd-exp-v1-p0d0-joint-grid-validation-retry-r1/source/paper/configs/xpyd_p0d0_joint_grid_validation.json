    "random_seed": 20260919,
    "frequency_settle_s": 0.15,
    "slo": {"ttft_ms": 500.0, "tpot_ms": 200.0},
    "coordinate_reconstruction": "min_total_energy_P_at_D_high_then_min_total_energy_D_at_selected_P",
