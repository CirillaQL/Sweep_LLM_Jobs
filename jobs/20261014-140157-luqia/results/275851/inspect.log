#!/usr/bin/env bash

# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

#SBATCH --job-name=cudastf-phase2d
#SBATCH --partition=short
#SBATCH --time=00:20:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=24G
#SBATCH --gres=gpu:L40s:2
#SBATCH --output=minerva-phase2d-%j.stdout.log
#SBATCH --error=minerva-phase2d-%j.stderr.log

set -euo pipefail

: "${HIGH_CLOCK_MHZ:?submit with --export=ALL,HIGH_CLOCK_MHZ=<MHz>,LOW_CLOCK_MHZ=<MHz>}"
: "${LOW_CLOCK_MHZ:?submit with --export=ALL,HIGH_CLOCK_MHZ=<MHz>,LOW_CLOCK_MHZ=<MHz>}"

if [[ -x "${SLURM_SUBMIT_DIR}/scripts/build.sh" ]]; then
  readonly spike_dir="${SLURM_SUBMIT_DIR}"
else
  readonly spike_dir="${SLURM_SUBMIT_DIR}/research_spikes/cudastf_region_planner"
fi
readonly cccl_dir="$(cd "${spike_dir}/../.." && pwd)"
readonly build_dir="${spike_dir}/build-minerva"
readonly results_dir="${spike_dir}/results/minerva_phase2d_${SLURM_JOB_ID}"
readonly conda_init="${MINERVA_CONDA_INIT:-/data/users/chjing/miniforge3/etc/profile.d/conda.sh}"
readonly conda_env="${MINERVA_CONDA_ENV:-cuda-env}"
readonly cmake_bin_dir="${cccl_dir}/.minerva-tools/cmake/data/bin"

source "${conda_init}"
conda activate "${conda_env}"
export PATH="${cmake_bin_dir}:${PATH}"
