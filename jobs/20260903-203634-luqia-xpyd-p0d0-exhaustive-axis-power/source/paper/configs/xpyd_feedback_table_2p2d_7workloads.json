{
  "model": "$XPYD_LOCAL_MODEL_PATH",
  "tokenizer_model": "$XPYD_LOCAL_MODEL_PATH",
  "vllm_version": "0.15.1",
  "output_root": "$XPYD_FEEDBACK_TABLE_OUTPUT_ROOT",
  "proxy_uri": "$XPYD_PROXY_URI",
  "proxy_diagnostics_log": "$XPYD_PROXY_DIAGNOSTICS_LOG",
  "frequency_table_path": "$XPYD_FREQUENCY_TABLE_PATH",
  "execution_mode": "exploration_only",
  "routing_policy": "round_robin",
  "workload_ordering": "windowed",
  "background_experiment_traffic": true,
  "online_feedback": {
    "enabled": true,
    "service_pair": ["P1", "D1"],
    "experiment_pair": ["P0", "D0"],
    "service_request_interval_s": 5.0,
    "probe_request_interval_s": 0.0,
    "service_frequency_settle_s": 0.5,
    "experiment_frequency_settle_s": 0.5,
    "service_warmup_requests": 0,
    "experiment_warmup_requests": 1,
    "probe_samples_per_candidate": 3,
    "minimum_probe_samples": 3,
    "candidate_stability_cv": 0.05,
    "candidate_slo_headroom_ratio": 0.90,
    "minimum_dwell_s": 0.5,
    "event_log": "$XPYD_FEEDBACK_EVENT_LOG",
    "service_request_log": "$XPYD_SERVICE_REQUEST_LOG",
    "slo": {"ttft_ms": 500.0, "tpot_ms": 200.0},
    "exploration_slo": {"ttft_ms": 500.0, "tpot_ms": 200.0},
    "exploration_slo_percentile": 95,
    "axis_search_levels": {"prefill": 17, "decode": 15},
    "frequency_grids": {
      "prefill": {"minimum_mhz": 900, "maximum_mhz": 2520, "levels": 17},
      "decode": {"minimum_mhz": 450, "maximum_mhz": 1500, "levels": 15}
    },
    "search_order": ["prefill", "decode"],
    "algorithm": "exhaustive_sequential_axis_minimum_endpoint_power",
    "exploration_wait_timeout_s": 25200
  },
  "steady_state": {
    "discard_first_per_configuration_window": 3,
    "minimum_samples": 8,
    "maximum_cv": 0.10
  },
  "scrape_interval_s": 1.0,
  "collector": {"timeout_s": 5.0},
  "pre_window_s": 1.0,
  "post_window_s": 0.5,
  "sampling": {
    "period_s": 0.2,
    "late_tolerance_s": 0.05,
    "readiness_timeout_s": 180.0,
    "maximum_gap_s": 0.5,
    "maximum_boundary_gap_s": 0.4,
    "minimum_coverage_ratio": 0.9
  },
  "client": {
    "script": "paper/scripts/replay_synthetic_trace.py",
    "max_concurrency": 1,
    "request_timeout_s": 900
