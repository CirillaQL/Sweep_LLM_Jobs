# Source this file through PD_CONFIG_FILE when running start_pd_vllm.sh.
# The enclosing sbatch allocation must reserve enough GPUs on both nodes.

MODEL=mistralai/Mistral-7B-v0.1
PYTHON_BIN=/data/users/chjing/miniforge3/envs/cuda-env/bin/python
VLLM_BIN=/data/users/chjing/miniforge3/envs/cuda-env/bin/vllm

# L40S Prefill node.
PREFILL_NODE=uranus
PREFILL_IP=10.1.0.5
PREFILL_NET_IFACE=enp160s0f0np0
PREFILL_REPLICAS=2
PREFILL_TP_SIZE=1
# Optional per-instance TP sizes override the uniform value above.
# PREFILL_TP_SIZES=1,1,2
PREFILL_GPU_MODEL=L40S

# L4 Decode node. The proxy runs here by default.
DECODE_NODE=ganymede
DECODE_IP=10.1.0.3
DECODE_NET_IFACE=eno12399np0
DECODE_REPLICAS=2
DECODE_TP_SIZE=1
# DECODE_TP_SIZES=1,1,2
DECODE_GPU_MODEL=L4
PROXY_NODE=ganymede
PROXY_IP=10.1.0.3

# Optional fixed ports. If omitted, ports are derived from SLURM_JOB_ID.
# PROXY_HTTP_PORT=30001
# PROXY_REGISTER_PORT=31001
# PREFILL_HTTP_PORT_BASE=32001
# DECODE_HTTP_PORT_BASE=33001
# PREFILL_KV_PORT_BASE=34001
# DECODE_KV_PORT_BASE=34001

MAX_MODEL_LEN=8192
MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=32
GPU_MEMORY_UTILIZATION=0.82
DTYPE=float16
ENFORCE_EAGER=true
CPUS_PER_GPU=8
VLLM_STEP_MEM=32G
STARTUP_TIMEOUT_SECONDS=900

# The default independently samples one live Prefill index and one live Decode
# index for every request. A seed is optional.
CUSTOM_PD_DEFAULT_ROUTE=random
# CUSTOM_PD_RANDOM_SEED=1234

# Runtime scripts and all framework caches are placed below PD_WORK_DIR and
# removed on exit. Persistent logs remain in PD_OUT_DIR.
# PD_WORK_DIR=/data/users/chjing/vllm_job_work/$SLURM_JOB_ID
# PD_OUT_DIR=/data/users/chjing/pd_vllm_results/$SLURM_JOB_ID
